# Server-only configuration. Never prefix these with VITE_ and never commit real values.
# Copy to .env for `vercel dev`; set in the Vercel dashboard for deployments.

# Gemini API key. Required from Phase 5 onward; unused by the Phase 1 shell.
GEMINI_API_KEY=

# Optional model override. Pick the fast structured-output model during Phase 5.
GEMINI_MODEL=
