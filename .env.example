# Server-only configuration. Never prefix these with VITE_ and never commit real values.
# Copy to .env for `vercel dev`; set in the Vercel dashboard for deployments.

# Gemini API key. REQUIRED for AI landing page audits.
# Get one at https://aistudio.google.com/.
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-3.6-flash when unset.
# Supports gemini-3.6-flash, gemini-3.7-flash (gemini-3.x models use low thinking to fit the latency budget).
GEMINI_MODEL=

# Supabase Auth & Database Configuration
# Public keys (safe for browser client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase keys
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Inngest Durable Workflows Configuration
# Set to 1 for local development / test mode without signature verification.
INNGEST_DEV=1
# Event key for sending events to Inngest (server-side only)
INNGEST_EVENT_KEY=
# Signing key for validating inbound Inngest webhooks in production (server-side only)
INNGEST_SIGNING_KEY=
