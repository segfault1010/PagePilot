{
  "name": "pagepilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm --filter @pagepilot/web dev",
    "build": "pnpm --filter @pagepilot/web build",
    "test": "vitest run --pool=forks --no-file-parallelism",
    "typecheck": "tsc -b",
    "verify:gemini": "node scripts/verify-gemini.mjs",
    "verify:supabase": "node scripts/verify-supabase-auth-runtime.mjs"
  },
  "dependencies": {
    "@pagepilot/api": "workspace:*",
    "@pagepilot/audit-engine": "workspace:*",
    "@pagepilot/contracts": "workspace:*",
    "@pagepilot/web": "workspace:*",
    "@pagepilot/workflows": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
